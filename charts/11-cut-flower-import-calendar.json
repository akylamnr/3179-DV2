{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Calendar heatmap of Australian imports for the combined cut-flower commodity in complete calendar years 2021-2025. The source tariff category does not distinguish individual flower varieties. Use the year slider to show its monthly values in the bar chart below.",
  "background": "transparent",
  "data": {
    "url": "data/cut_flower_imports_calendar_heatmap.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "month": "number",
        "import_value_aud_m": "number",
        "quantity_kg": "number",
        "source_rows": "number"
      }
    }
  },
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    }
  },
  "title": {
    "text": "When Does Australia Import Cut Flowers?",
    "subtitle": "Monthly CIF import value · AUD million · 2021-2025",
    "font": "Inter",
    "fontSize": 20,
    "fontWeight": 700,
    "color": "#1f382f",
    "anchor": "start",
    "offset": 12,
    "subtitleFont": "Inter",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#74686D",
    "subtitlePadding": 4
  },
  "spacing": 6,
  "vconcat": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 2,
        "cornerRadius": 3
      },
      "encoding": {
        "x": {
          "field": "month_name",
          "type": "ordinal",
          "sort": [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"
          ],
          "title": "Month",
          "axis": {
            "labelAngle": 0,
            "labelFontSize": 13,
            "grid": false,
            "ticks": false,
            "domain": false,
            "labelFont": "Inter",
            "titleFont": "Inter",
            "titleFontSize": 13,
            "labelColor": "#1B2B26",
            "titleColor": "#1B2B26",
            "titleFontWeight": 600
          }
        },
        "y": {
          "field": "year",
          "type": "ordinal",
          "sort": [
            2021,
            2022,
            2023,
            2024,
            2025
          ],
          "title": null,
          "axis": {
            "labelFontSize": 13,
            "grid": false,
            "ticks": false,
            "domain": false,
            "labelFont": "Inter",
            "titleFont": "Inter",
            "titleFontSize": 13,
            "labelColor": "#1B2B26",
            "titleColor": "#1B2B26",
            "titleFontWeight": 600
          }
        },
        "color": {
          "field": "import_value_aud_m",
          "type": "quantitative",
          "title": "CIF value (AUD million)",
          "scale": {
            "domain": [
              8,
              20.5
            ],
            "clamp": true,
            "range": [
              "#F1F6EF",
              "#D5E6C8",
              "#9CC58F",
              "#4F9A6B",
              "#28483D"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "format": ".0f",
            "gradientLength": 340,
            "titleFontSize": 13,
            "labelFontSize": 13,
            "labelFont": "Inter",
            "titleFont": "Inter",
            "labelColor": "#1B2B26",
            "titleColor": "#1B2B26",
            "titleFontWeight": 600
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "month_name",
            "type": "ordinal",
            "title": "Month"
          },
          {
            "field": "import_value_aud_m",
            "type": "quantitative",
            "title": "Import CIF value (AUD million)",
            "format": ".2f"
          },
          {
            "field": "quantity_kg",
            "type": "quantitative",
            "title": "Reported quantity (kg)",
            "format": ",.0f"
          },
          {
            "field": "source_rows",
            "type": "quantitative",
            "title": "Source records",
            "format": ",.0f"
          },
          {
            "field": "commodity_code",
            "type": "nominal",
            "title": "Commodity code"
          }
        ],
        "opacity": {
          "condition": {
            "test": "datum.year == yr",
            "value": 1
          },
          "value": 0.55
        }
      },
      "width": 680,
      "height": 230
    },
    {
      "width": 680,
      "height": 130,
      "transform": [
        {
          "filter": "datum.year == yr"
        }
      ],
      "mark": {
        "type": "bar",
        "color": "#28483D",
        "cornerRadiusEnd": 2
      },
      "encoding": {
        "x": {
          "field": "month_name",
          "type": "ordinal",
          "sort": [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"
          ],
          "title": null,
          "axis": {
            "labels": false,
            "ticks": false,
            "domain": false,
            "labelFont": "Inter",
            "titleFont": "Inter",
            "labelFontSize": 13,
            "titleFontSize": 13,
            "labelColor": "#1B2B26",
            "titleColor": "#1B2B26",
            "titleFontWeight": 600
          }
        },
        "y": {
          "field": "import_value_aud_m",
          "type": "quantitative",
          "title": "AUD million",
          "axis": {
            "grid": false,
            "format": ".0f",
            "tickCount": 4,
            "labelFont": "Inter",
            "titleFont": "Inter",
            "labelFontSize": 13,
            "titleFontSize": 13,
            "labelColor": "#1B2B26",
            "titleColor": "#1B2B26",
            "titleFontWeight": 600
          },
          "scale": {
            "domain": [
              0,
              22
            ]
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "month_name",
            "type": "ordinal",
            "title": "Month"
          },
          {
            "field": "import_value_aud_m",
            "type": "quantitative",
            "title": "Import value (AUD million)",
            "format": ".2f"
          }
        ]
      }
    }
  ],
  "params": [
    {
      "name": "yr",
      "value": 2025,
      "bind": {
        "input": "range",
        "min": 2021,
        "max": 2025,
        "step": 1,
        "name": "Year: "
      }
    }
  ]
}