{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bump chart ranking Australia's six selected fresh-cut flower suppliers by annual import value. Rank 1 is the largest supplier.",
  "title": {
    "text": "Malaysia overtakes Kenya as Australia's leading supplier",
    "subtitle": "Annual import value for fresh-cut flowers and buds (HS 060310) · 2017-2024 · Rank 1 = largest",
    "font": "Inter",
    "fontSize": 16,
    "anchor": "start",
    "subtitleFont": "Inter",
    "subtitleFontSize": 10,
    "subtitleColor": "#74686D",
    "offset": 10
  },
  "width": 650,
  "height": 300,
  "padding": {
    "left": 10,
    "right": 105,
    "top": 8,
    "bottom": 8
  },
  "background": "#FFFFFF",
  "data": {
    "url": "data/flower_imports_by_country_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "import_value_usd_m": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "import_value_usd_m",
          "order": "descending"
        }
      ],
      "groupby": ["year"]
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "year",
          "as": "last_year"
        }
      ]
    }
  ],
  "params": [
    {
      "name": "hl",
      "select": {
        "type": "point",
        "fields": ["country"],
        "on": "pointerover",
        "clear": "pointerout"
      }
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "sort": [2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024],
      "title": "Year",
      "axis": {
        "labelAngle": 0,
        "labelFont": "Inter",
        "labelFontSize": 9,
        "labelPadding": 4,
        "titleFont": "Inter",
        "titleFontSize": 10,
        "titlePadding": 7,
        "grid": false,
        "domain": true,
        "domainColor": "#8E8078",
        "domainWidth": 1.5,
        "ticks": true,
        "tickSize": 4,
        "tickColor": "#8E8078",
        "labelColor": "#5B4E49",
        "titleColor": "#5B4E49",
        "labelOverlap": false
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "title": "Rank (1 = largest supplier)",
      "scale": {
        "domain": [1, 6],
        "reverse": true,
        "nice": false,
        "zero": false
      },
      "axis": {
        "values": [1, 2, 3, 4, 5, 6],
        "format": ".0f",
        "labelFont": "Inter",
        "labelFontSize": 10,
        "labelPadding": 4,
        "titleFont": "Inter",
        "titleFontSize": 10,
        "titlePadding": 7,
        "grid": true,
        "gridColor": "#E8DFDB",
        "gridOpacity": 1,
        "domain": true,
        "domainColor": "#8E8078",
        "domainWidth": 1.5,
        "ticks": true,
        "tickSize": 4,
        "tickColor": "#8E8078",
        "labelColor": "#5B4E49",
        "titleColor": "#5B4E49"
      }
    },
    "color": {
      "field": "country",
      "type": "nominal",
      "scale": {
        "domain": ["Malaysia", "Kenya", "Ecuador", "Colombia", "China", "Vietnam"],
        "range": ["#176B63", "#D98B35", "#329481", "#C0562B", "#7E8DA6", "#8D7770"]
      },
      "legend": null
    },
    "detail": {
      "field": "country"
    },
    "order": {
      "field": "year",
      "sort": [2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024]
    },
    "opacity": {
      "condition": {
        "param": "hl",
        "value": 1
      },
      "value": 0.18
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.4,
        "clip": false
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 65,
        "filled": true,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.8
      },
      "encoding": {
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Supplier"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank",
            "format": ".0f"
          },
          {
            "field": "import_value_usd_m",
            "type": "quantitative",
            "title": "Import value (US$ million)",
            "format": ",.2f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === datum.last_year"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 7,
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 600,
        "clip": false
      },
      "encoding": {
        "text": {
          "field": "country",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Inter",
      "fontSize": 16,
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleFontSize": 10,
      "subtitleColor": "#74686D"
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 9,
      "titleFontSize": 10,
      "labelColor": "#5B4E49",
      "titleColor": "#5B4E49"
    }
  }
}
