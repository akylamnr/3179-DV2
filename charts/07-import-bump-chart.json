{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bump chart ranking Australia's six selected fresh-cut flower suppliers by annual import value. Rank 1 is the largest supplier.",
  "title": {
    "text": "Vietnam Climbs to Second Among Australia's Flower Suppliers",
    "subtitle": "Annual import value for fresh-cut flowers and buds (2025 from WITS, HS 0603) · 2017–2025 · Rank 1 = largest",
    "font": "Inter",
    "fontSize": 20,
    "fontWeight": 700,
    "color": "#1f382f",
    "anchor": "start",
    "offset": 12,
    "subtitleFont": "Inter",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#74686D",
    "subtitlePadding": 4
  },
  "width": 700,
  "height": 300,
  "background": "transparent",
  "data": {
    "url": "data/flower_imports_by_country_year.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number",
        "import_value_usd_m": "number"
      }
    }
  },
  "transform": [
    {
      "window": [
        {
          "op": "rank",
          "as": "rank"
        }
      ],
      "sort": [
        {
          "field": "import_value_usd_m",
          "order": "descending"
        }
      ],
      "groupby": [
        "year"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "year",
          "as": "last_year"
        }
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "sort": [
        2017,
        2018,
        2019,
        2020,
        2021,
        2022,
        2023,
        2024,
        2025
      ],
      "title": "Year",
      "axis": {
        "labelAngle": 0,
        "labelFont": "Inter",
        "labelFontSize": 13,
        "labelPadding": 4,
        "titleFont": "Inter",
        "titleFontSize": 13,
        "titlePadding": 7,
        "grid": false,
        "domain": true,
        "domainColor": "#8E8078",
        "domainWidth": 1.5,
        "ticks": true,
        "tickSize": 4,
        "tickColor": "#8E8078",
        "labelColor": "#1B2B26",
        "titleColor": "#1B2B26",
        "labelOverlap": false,
        "titleFontWeight": 600
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "title": "Rank",
      "scale": {
        "domain": [
          0.6,
          6.4
        ],
        "reverse": true,
        "nice": false,
        "zero": false
      },
      "axis": {
        "values": [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "format": ".0f",
        "labelFont": "Inter",
        "labelFontSize": 15,
        "labelPadding": 4,
        "titleFont": "Inter",
        "titleFontSize": 15,
        "titlePadding": 7,
        "grid": true,
        "gridColor": "#E8DFDB",
        "gridOpacity": 1,
        "domain": true,
        "domainColor": "#8E8078",
        "domainWidth": 1.5,
        "ticks": true,
        "tickSize": 4,
        "tickColor": "#8E8078",
        "labelColor": "#1B2B26",
        "titleColor": "#1B2B26",
        "titleFontWeight": 600
      }
    },
    "color": {
      "field": "country",
      "type": "nominal",
      "scale": {
        "domain": [
          "Malaysia",
          "Kenya",
          "Ecuador",
          "Colombia",
          "China",
          "Vietnam"
        ],
        "range": [
          "#2E9FD0",
          "#1F9A55",
          "#6A4FC0",
          "#BDB6AF",
          "#BDB6AF",
          "#D2A21C"
        ]
      },
      "legend": null
    },
    "detail": {
      "field": "country"
    },
    "order": {
      "field": "year",
      "sort": [
        2017,
        2018,
        2019,
        2020,
        2021,
        2022,
        2023,
        2024,
        2025
      ]
    },
    "opacity": {
      "condition": {
        "param": "hl",
        "value": 1
      },
      "value": 0.18
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.4,
        "clip": false
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 65,
        "filled": true,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.8
      },
      "encoding": {
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Supplier"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank",
            "format": ".0f"
          },
          {
            "field": "import_value_usd_m",
            "type": "quantitative",
            "title": "Import value (USD million)",
            "format": ",.2f"
          }
        ]
      },
      "params": [
        {
          "name": "hl",
          "select": {
            "type": "point",
            "fields": [
              "country"
            ],
            "on": "pointerover",
            "clear": "pointerout"
          }
        }
      ]
    },
    {
      "transform": [
        {
          "filter": "datum.year === datum.last_year"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 7,
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 600,
        "clip": false
      },
      "encoding": {
        "text": {
          "field": "country",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    }
  }
}