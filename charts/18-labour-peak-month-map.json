{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where does Australian horticulture need the most workers?",
    "subtitle": "Total labour use in the peak month · 2023–24 · Number of workers by region",
    "font": "Inter",
    "fontWeight": 700,
    "fontSize": 19,
    "anchor": "start",
    "subtitleFont": "Inter",
    "subtitleFontSize": 12,
    "subtitleColor": "#74686D",
    "offset": 10,
    "color": "#1f382f",
    "subtitleFontWeight": "normal"
  },
  "description": "Choropleth of ABARES horticulture labour regions shaded by estimated total workers used in the peak month in 2023-24.",
  "width": 560,
  "height": 480,
  "background": "transparent",
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -28
    ],
    "scale": 700,
    "translate": [
      270,
      225
    ]
  },
  "layer": [
    {
      "data": {
        "url": "maps/australia_sa4_labour_regions.topojson",
        "format": {
          "type": "topojson",
          "feature": "regions"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F1EFEA",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "maps/australia_sa4_labour_regions.topojson",
        "format": {
          "type": "topojson",
          "feature": "regions"
        }
      },
      "transform": [
        {
          "lookup": "properties.region",
          "from": {
            "data": {
              "url": "data/labour_peak_month_by_region.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "workers_2023_24": "number",
                  "rse_2023_24_pct": "number"
                }
              }
            },
            "key": "region",
            "fields": [
              "workers_2023_24",
              "rse_2023_24_pct"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.4
      },
      "encoding": {
        "color": {
          "field": "workers_2023_24",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              1000,
              2500,
              4000,
              6000,
              10000
            ],
            "range": [
              "#F6E8D3",
              "#EFCF9F",
              "#E6AE68",
              "#D9822B",
              "#B3601C",
              "#7A3D0E"
            ]
          },
          "legend": {
            "title": "Workers in peak month",
            "orient": "right",
            "direction": "vertical",
            "format": ",.0f",
            "labelFont": "Inter",
            "titleFont": "Inter",
            "labelFontSize": 13,
            "titleFontSize": 13,
            "labelColor": "#5B4E49",
            "titleColor": "#5B4E49",
            "titleFontWeight": 600,
            "symbolType": "square",
            "symbolSize": 200
          }
        },
        "tooltip": [
          {
            "field": "properties.region",
            "type": "nominal",
            "title": "Region"
          },
          {
            "field": "properties.state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "workers_2023_24",
            "type": "quantitative",
            "title": "Workers in peak month, 2023–24",
            "format": ",.0f"
          },
          {
            "field": "rse_2023_24_pct",
            "type": "quantitative",
            "title": "RSE (%)",
            "format": ".0f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    }
  },
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 5
  }
}