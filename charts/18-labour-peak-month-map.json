{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where does Australian horticulture need the most workers?",
    "subtitle": "Hexagon bins · Sum of regional peak-month workers · 2023–24",
    "font": "Inter",
    "fontWeight": 700,
    "fontSize": 19,
    "anchor": "start",
    "subtitleFont": "Inter",
    "subtitleFontSize": 12,
    "subtitleColor": "#74686D",
    "offset": 10,
    "color": "#1f382f",
    "subtitleFontWeight": "normal"
  },
  "description": "Hexagon-bin map of Australia. Each hexagon sums the estimated workers used in the peak month in 2023-24 across the ABARES labour regions whose centres fall inside it.",
  "width": 560,
  "height": 480,
  "background": "transparent",
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -28
    ],
    "scale": 700,
    "translate": [
      270,
      225
    ]
  },
  "layer": [
    {
      "data": {
        "url": "maps/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F1EFEA",
        "stroke": "#D9D5CC",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/labour_peak_month_hexbins.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5,
        "opacity": 0.95
      },
      "encoding": {
        "color": {
          "field": "properties.workers",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [
              2000,
              5000,
              10000,
              20000,
              30000
            ],
            "range": [
              "#F6E8D3",
              "#EFCF9F",
              "#E6AE68",
              "#D9822B",
              "#B3601C",
              "#7A3D0E"
            ]
          },
          "legend": {
            "title": "Workers in peak month",
            "orient": "right",
            "direction": "vertical",
            "format": ",.0f",
            "labelFont": "Inter",
            "titleFont": "Inter",
            "labelFontSize": 13,
            "titleFontSize": 13,
            "labelColor": "#5B4E49",
            "titleColor": "#5B4E49",
            "titleFontWeight": 600,
            "symbolType": "square",
            "symbolSize": 200
          }
        },
        "tooltip": [
          {
            "field": "properties.workers",
            "type": "quantitative",
            "title": "Workers in peak month (sum)",
            "format": ",.0f"
          },
          {
            "field": "properties.n_regions",
            "type": "quantitative",
            "title": "Regions in hexagon"
          },
          {
            "field": "properties.states",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "properties.regions",
            "type": "nominal",
            "title": "Regions"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    }
  },
  "padding": {
    "left": 5,
    "right": 5,
    "top": 5,
    "bottom": 5
  }
}