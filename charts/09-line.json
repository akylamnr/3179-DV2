{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Interactive flow map of Australia's imports of fresh-cut flowers and buds by supplier and year from 2017 to 2024. HS 060310 under HS 1988/92, import values in US$ million. Move the year slider to update the routes.",
  "width": 430,
  "height": 340,
  "background": "#FFFFFF",
  "title": {
    "text": "Where do Australia's imported flowers come from?",
    "subtitle": "Fresh-cut flowers and buds · Choose a year to compare supplier values (US$ million)",
    "font": "Inter",
    "fontSize": 21,
    "fontWeight": "bold",
    "anchor": "start",
    "offset": 12,
    "subtitleFont": "Inter",
    "subtitleFontSize": 12,
    "subtitleColor": "#74686D"
  },
  "params": [
    {
      "name": "selectedYear",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2017,
        "max": 2024,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0,
      0
    ]
  },
  "resolve": {
    "scale": {
      "size": "independent"
    }
  },
  "layer": [
    {
      "data": {
        "url": "maps/world_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "world_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F1EEE9",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.55
      }
    },
    {
      "data": {
        "url": "data/flower_imports_by_country_year_flow.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "longitude": "number",
            "latitude": "number",
            "import_value_usd_m": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year == selectedYear"
        },
        {
          "calculate": "datum.longitude < -30 ? datum.longitude + 360 : datum.longitude",
          "as": "lon0"
        },
        {
          "calculate": "149.13",
          "as": "lon2"
        },
        {
          "calculate": "-35.28",
          "as": "lat2"
        },
        {
          "calculate": "0.5 * (datum.lon0 + datum.lon2)",
          "as": "ctrl_lon"
        },
        {
          "calculate": "0.5 * (datum.latitude + datum.lat2) + 0.22 * abs(datum.lon2 - datum.lon0)",
          "as": "ctrl_lat"
        },
        {
          "calculate": "sequence(0, 41)",
          "as": "step"
        },
        {
          "flatten": [
            "step"
          ]
        },
        {
          "calculate": "datum.step / 40",
          "as": "t"
        },
        {
          "calculate": "pow(1 - datum.t, 2) * datum.lon0 + 2 * (1 - datum.t) * datum.t * datum.ctrl_lon + pow(datum.t, 2) * datum.lon2",
          "as": "arc_lon"
        },
        {
          "calculate": "pow(1 - datum.t, 2) * datum.latitude + 2 * (1 - datum.t) * datum.t * datum.ctrl_lat + pow(datum.t, 2) * datum.lat2",
          "as": "arc_lat"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#D98B35",
        "opacity": 0.72,
        "strokeCap": "round"
      },
      "encoding": {
        "longitude": {
          "field": "arc_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "arc_lat",
          "type": "quantitative"
        },
        "detail": {
          "field": "route",
          "type": "nominal"
        },
        "order": {
          "field": "step",
          "type": "quantitative"
        },
        "size": {
          "field": "import_value_usd_m",
          "type": "quantitative",
          "title": "Import value (US$M)",
          "scale": {
            "domain": [
              0,
              25
            ],
            "range": [
              1.2,
              6.2
            ],
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              5,
              10,
              15,
              20,
              25
            ],
            "format": ".0f",
            "symbolType": "stroke",
            "symbolStrokeColor": "#D98B35",
            "title": "Import value (US$M)",
            "labelFont": "Inter",
            "titleFont": "Inter",
            "labelFontSize": 11,
            "titleFontSize": 11,
            "padding": 6
          }
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Supplier"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "import_value_usd_m",
            "type": "quantitative",
            "title": "Import value (US$ million)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/flower_imports_by_country_year_flow.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "longitude": "number",
            "latitude": "number",
            "import_value_usd_m": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year == selectedYear"
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.2,
        "opacity": 0.95,
        "color": "#B85C16"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "import_value_usd_m",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              25
            ],
            "range": [
              60,
              600
            ],
            "clamp": true
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Supplier"
          },
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "import_value_usd_m",
            "type": "quantitative",
            "title": "Import value (US$ million)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/flower_imports_by_country_year_flow.csv",
        "format": {
          "type": "csv",
          "parse": {
            "year": "number",
            "longitude": "number",
            "latitude": "number",
            "import_value_usd_m": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.year == selectedYear"
        },
        {
          "calculate": "datum.country === 'Colombia' ? datum.latitude + 6 : datum.country === 'Ecuador' ? datum.latitude - 4 : datum.latitude",
          "as": "label_latitude"
        }
      ],
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 10,
        "fontWeight": "bold",
        "lineBreak": "\n",
        "align": "center"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "country",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "Australia",
            "longitude": 149.13,
            "latitude": -35.28
          }
        ]
      },
      "mark": {
        "type": "point",
        "shape": "diamond",
        "filled": true,
        "size": 200,
        "color": "#176B63",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": {
          "field": "name",
          "type": "nominal",
          "title": "Destination"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "Australia",
            "longitude": 149.13,
            "latitude": -35.28
          }
        ]
      },
      "mark": {
        "type": "text",
        "dy": 17,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#176B63",
        "font": "Inter",
        "stroke": "#FFFFFF",
        "strokeWidth": 2
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "background": "#FFFFFF",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Newsreader",
      "fontSize": 21,
      "fontWeight": "bold",
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleFontSize": 12,
      "subtitleColor": "#74686D",
      "offset": 12
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "padding": 5
    },
    "axis": {
      "labelColor": "#40363A",
      "titleColor": "#40363A"
    }
  }
}
