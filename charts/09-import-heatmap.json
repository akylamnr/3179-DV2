{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap of Australia's imports of fresh-cut flowers and buds by partner country from 2017 to 2024. Values use HS code 060310 under HS 1988/92 and are reported in US$ million.",
  "width": 620,
  "height": 270,
  "background": "#FFFFFF",
  "title": {
    "text": "A handful of countries supply most fresh-cut flowers",
    "subtitle": "Australia's imports of fresh-cut flowers and buds, 2017\u20132024 \u00b7 US$ million",
    "font": "Inter",
    "fontSize": 18,
    "subtitleFont": "Inter",
    "subtitleFontSize": 12,
    "subtitleColor": "#74686D",
    "anchor": "start",
    "offset": 12
  },
  "data": {
    "url": "data/flower_imports_by_country_year.csv",
    "format": {
      "type": "csv"
    }
  },
  "params": [
    {
      "name": "selectCountry",
      "select": {
        "type": "point",
        "fields": [
          "country"
        ],
        "on": "click",
        "clear": "dblclick"
      }
    }
  ],
  "mark": {
    "type": "rect",
    "stroke": "#FFFFFF",
    "strokeWidth": 2,
    "cornerRadius": 2,
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "sort": [
        2017,
        2018,
        2019,
        2020,
        2021,
        2022,
        2023,
        2024
      ],
      "title": null,
      "axis": {
        "labelAngle": 0,
        "labelFont": "Inter",
        "labelFontSize": 11,
        "ticks": false,
        "domain": false
      }
    },
    "y": {
      "field": "country",
      "type": "ordinal",
      "sort": [
        "Malaysia",
        "Kenya",
        "Ecuador",
        "Colombia",
        "China",
        "Vietnam"
      ],
      "title": null,
      "axis": {
        "labelFont": "Inter",
        "labelFontSize": 12,
        "ticks": false,
        "domain": false,
        "labelPadding": 8
      }
    },
    "color": {
      "field": "import_value_usd_m",
      "type": "quantitative",
      "title": "Import value (US$ million)",
      "scale": {
        "domain": [
          0,
          25
        ],
        "range": [
          "#F7E8D7",
          "#C66A24"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "gradientLength": 260,
        "format": ".0f",
        "titleFont": "Inter",
        "labelFont": "Inter"
      }
    },
    "opacity": {
      "condition": {
        "param": "selectCountry",
        "value": 1
      },
      "value": 0.22
    },
    "tooltip": [
      {
        "field": "country",
        "type": "nominal",
        "title": "Supplier"
      },
      {
        "field": "year",
        "type": "ordinal",
        "title": "Year"
      },
      {
        "field": "import_value_usd_m",
        "type": "quantitative",
        "title": "Import value (US$ million)",
        "format": ".2f"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "grid": false,
      "labelColor": "#40363A",
      "titleColor": "#40363A"
    }
  }
}
