{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional-symbol map of Australia's reported imports of cut flowers and flower buds (HS 0603) by partner country, calendar year 2024. Circle size represents trade value. The six highest-value reported supplier countries are labeled directly; hover over the other circles for details.",
  "width": 820,
  "height": 450,
  "title": {
    "text": "Where do Australia's imported flowers come from? (2024)",
    "subtitle": "Cut flowers and buds (HS 0603) · 2024 · Import value in US$ million"
  },
  "projection": {
    "type": "equalEarth"
  },
  "layer": [
    {
      "data": {
        "url": "maps/world_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "world_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F1EEE9",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.55
      }
    },
    {
      "data": {
        "url": "data/flower_imports_by_country.csv",
        "format": {
          "type": "csv"
        }
      },
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.78,
        "stroke": "#FFFFFF",
        "strokeWidth": 0.8,
        "tooltip": true
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "import_value_usd_m",
          "type": "quantitative",
          "title": "Import value (US$ million)",
          "scale": {
            "domain": [
              0,
              20
            ],
            "range": [
              24,
              1000
            ],
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "symbolFillColor": "#D98B35",
            "title": "Import value (US$ million)",
            "format": ".1f"
          }
        },
        "color": {
          "value": "#D98B35"
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Partner country"
          },
          {
            "field": "import_value_usd_m",
            "type": "quantitative",
            "title": "Import value (US$ million)",
            "format": ".2f"
          },
          {
            "field": "quantity_kg",
            "type": "quantitative",
            "title": "Quantity (kg)",
            "format": ","
          },
          {
            "field": "share_of_reported_total_pct",
            "type": "quantitative",
            "title": "Share of reported total (%)",
            "format": ".2f"
          },
          {
            "field": "year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "hs_code",
            "type": "nominal",
            "title": "HS code"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/flower_imports_by_country.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "datum.import_value_usd_m >= 9"
        },
        {
          "calculate": "datum.country === 'Malaysia' ? 119 : datum.country === 'Kenya' ? 25 : datum.country === 'Ecuador' ? -94 : datum.country === 'Vietnam' ? 122 : datum.country === 'Colombia' ? -86 : datum.country === 'China' ? 105 : datum.longitude",
          "as": "label_longitude"
        },
        {
          "calculate": "datum.country === 'Malaysia' ? 8 : datum.country === 'Kenya' ? 7 : datum.country === 'Ecuador' ? 5 : datum.country === 'Vietnam' ? 21 : datum.country === 'Colombia' ? 11 : datum.country === 'China' ? 44 : datum.latitude",
          "as": "label_latitude"
        },
        {
          "calculate": "datum.country + '  $' + format(datum.import_value_usd_m, '.1f') + 'm'",
          "as": "country_label"
        }
      ],
  
      "encoding": {
        "longitude": {
          "field": "label_longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "country_label",
          "type": "nominal"
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Partner country"
          },
          {
            "field": "import_value_usd_m",
            "type": "quantitative",
            "title": "Import value (US$ million)",
            "format": ".2f"
          }
        ]
      }
    }
  ],
  "config": {
    "font": "Inter",
    "background": "#FFFFFF",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Inter",
      "fontSize": 22,
      "fontWeight": "bold",
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#74686D",
      "offset": 14
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 11,
      "titleFontSize": 12,
      "padding": 5
    }
  }
}
