{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Streamgraph of Australia's cut-flower imports by supplier country over time. Band thickness shows import value; total thickness shows total imports.",
  "width": 760,
  "height": 340,
  "title": {
    "text": "Who has supplied our flowers over time",
    "subtitle": "Import value in US$ million per year, by supplier country. Band thickness shows value. Click a country in the legend to highlight it."
  },
  "data": {
    "url": "data/flower_imports_by_country_year.csv",
    "format": {"type": "csv", "parse": {"year": "number", "value_usd_m": "number"}}
  },
  "transform": [
    {"calculate": "datetime(datum.year, 0, 1)", "as": "date"},
    {"joinaggregate": [{"op": "sum", "field": "value_usd_m", "as": "country_total"}], "groupby": ["country"]},
    {"joinaggregate": [{"op": "sum", "field": "value_usd_m", "as": "year_total"}], "groupby": ["year"]}
  ],
  "layer": [
    {
      "params": [{"name": "pick", "select": {"type": "point", "fields": ["country"]}, "bind": "legend"}],
      "mark": {"type": "area", "interpolate": "monotone", "stroke": "#FFFFFF", "strokeWidth": 0.6},
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": null,
          "axis": {"format": "%Y", "grid": false, "domain": false, "tickCount": {"interval": "year", "step": 2}}
        },
        "y": {"field": "value_usd_m", "type": "quantitative", "stack": "center", "axis": null},
        "color": {
          "field": "country",
          "type": "nominal",
          "title": null,
          "scale": {"range": ["#8C4A0F", "#B96A1C", "#D98B35", "#EBA95C", "#F2C48C", "#C9C7BE", "#9AA5A0"]},
          "legend": {"orient": "bottom", "symbolType": "square"}
        },
        "order": {"field": "country_total", "type": "quantitative", "sort": "descending"},
        "opacity": {"condition": {"param": "pick", "value": 1}, "value": 0.25}
      }
    },
    {
      "transform": [{"aggregate": [{"op": "max", "field": "year_total", "as": "total"}], "groupby": ["date", "year"]}],
      "params": [
        {"name": "hover", "select": {"type": "point", "fields": ["date"], "nearest": true, "on": "pointerover", "clear": "pointerout"}}
      ],
      "mark": {"type": "rule", "color": "#1B2B26", "strokeWidth": 1},
      "encoding": {
        "x": {"field": "date", "type": "temporal", "title": null},
        "opacity": {"condition": {"param": "hover", "value": 0.5, "empty": false}, "value": 0},
        "tooltip": [
          {"field": "year", "type": "ordinal", "title": "Year"},
          {"field": "total", "type": "quantitative", "title": "All suppliers (US$ million)", "format": ".1f"}
        ]
      }
    }
  ]
}
