{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Total Horticulture Production by State",
    "font": "Inter",
    "fontWeight": 700,
    "fontSize": 19,
    "anchor": "start",
    "offset": 10,
    "color": "#1f382f"
  },
  "description": "Australian state map with one proportional circle per state, showing farm-gate production value summed across the five ABS horticulture summary categories. Circle size is grouped into three value classes.",
  "width": 350,
  "height": 360,
  "background": "transparent",
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -27
    ],
    "scale": 405,
    "translate": [
      175,
      180
    ]
  },
  "layer": [
    {
      "data": {
        "url": "maps/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#D8D5D2",
        "stroke": "#28483D",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "data/horticulture_total_by_state.csv",
        "format": {
          "type": "csv",
          "parse": {
            "total_farm_gate_value_aud_m": "number"
          }
        }
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "values": [
                {
                  "state": "Western Australia",
                  "longitude": 121.5,
                  "latitude": -25.5
                },
                {
                  "state": "Northern Territory",
                  "longitude": 133.5,
                  "latitude": -19.5
                },
                {
                  "state": "Queensland",
                  "longitude": 146.5,
                  "latitude": -22.5
                },
                {
                  "state": "South Australia",
                  "longitude": 135.0,
                  "latitude": -30.0
                },
                {
                  "state": "New South Wales",
                  "longitude": 150.5,
                  "latitude": -32.5
                },
                {
                  "state": "Australian Capital Territory",
                  "longitude": 152.0,
                  "latitude": -35.3
                },
                {
                  "state": "Victoria",
                  "longitude": 142.5,
                  "latitude": -37.0
                },
                {
                  "state": "Tasmania",
                  "longitude": 146.5,
                  "latitude": -42.0
                }
              ]
            },
            "key": "state",
            "fields": [
              "longitude",
              "latitude"
            ]
          }
        },
        {
          "filter": "isValid(datum.total_farm_gate_value_aud_m)"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": true,
        "color": "#28483D",
        "opacity": 0.82
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "value_class",
          "type": "ordinal",
          "sort": [
            "Under A$2b",
            "A$2b to <A$4b",
            "A$4b or more"
          ],
          "scale": {
            "domain": [
              "Under A$2b",
              "A$2b to <A$4b",
              "A$4b or more"
            ],
            "range": [
              100,
              700,
              1800
            ]
          },
          "legend": {
            "title": "Farm-gate value ($A billion)",
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "circle",
            "symbolFillColor": "#D6538A",
            "symbolStrokeColor": "#FFFFFF",
            "labelFontSize": 13,
            "titleFontSize": 13,
            "labelFont": "Inter",
            "titleFont": "Inter",
            "labelColor": "#5B4E49",
            "titleColor": "#5B4E49",
            "titleFontWeight": 600
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "total_farm_gate_value_aud_m",
            "type": "quantitative",
            "title": "Five-category value (A$ million)",
            "format": ",.1f"
          },
          {
            "field": "value_class",
            "type": "nominal",
            "title": "Value class"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "code": "WA",
            "longitude": 121.5,
            "latitude": -27.0
          },
          {
            "code": "NT",
            "longitude": 133.5,
            "latitude": -21.0
          },
          {
            "code": "QLD",
            "longitude": 146.5,
            "latitude": -24.0
          },
          {
            "code": "SA",
            "longitude": 135.0,
            "latitude": -31.5
          },
          {
            "code": "NSW",
            "longitude": 150.5,
            "latitude": -34.0
          },
          {
            "code": "VIC",
            "longitude": 142.5,
            "latitude": -38.2
          },
          {
            "code": "TAS",
            "longitude": 146.5,
            "latitude": -43.5
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#30272B",
        "dy": 4
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "code",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    }
  }
}