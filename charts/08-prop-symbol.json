{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Total Horticulture Production by State",
    "subtitle": "Farm-gate value of the five horticulture categories · 2024–25",
    "font": "Inter",
    "fontSize": 20,
    "fontWeight": 700,
    "color": "#1f382f",
    "anchor": "start",
    "offset": 12,
    "subtitleFont": "Inter",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#74686D",
    "subtitlePadding": 4
  },
  "description": "Australian state map with one proportional circle per state, showing farm-gate production value summed across the five ABS horticulture summary categories. Circle size is grouped into three value classes.",
  "width": 350,
  "height": 360,
  "background": "transparent",
  "projection": {
    "type": "mercator",
    "center": [
      134,
      -27
    ],
    "scale": 405,
    "translate": [
      175,
      180
    ]
  },
  "layer": [
    {
      "data": {
        "url": "maps/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ECE6E0",
        "stroke": "#A8998C",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/horticulture_total_by_state.csv",
        "format": {
          "type": "csv",
          "parse": {
            "total_farm_gate_value_aud_m": "number"
          }
        }
      },
      "transform": [
        {
          "lookup": "state",
          "from": {
            "data": {
              "values": [
                {
                  "state": "Western Australia",
                  "longitude": 121.5,
                  "latitude": -25.5
                },
                {
                  "state": "Northern Territory",
                  "longitude": 133.5,
                  "latitude": -19.5
                },
                {
                  "state": "Queensland",
                  "longitude": 146.5,
                  "latitude": -22.5
                },
                {
                  "state": "South Australia",
                  "longitude": 135.0,
                  "latitude": -30.0
                },
                {
                  "state": "New South Wales",
                  "longitude": 150.5,
                  "latitude": -32.5
                },
                {
                  "state": "Australian Capital Territory",
                  "longitude": 152.0,
                  "latitude": -35.3
                },
                {
                  "state": "Victoria",
                  "longitude": 143.6,
                  "latitude": -36.6
                },
                {
                  "state": "Tasmania",
                  "longitude": 146.5,
                  "latitude": -42.0
                }
              ]
            },
            "key": "state",
            "fields": [
              "longitude",
              "latitude"
            ]
          }
        },
        {
          "filter": "isValid(datum.total_farm_gate_value_aud_m)"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "circle",
        "filled": true,
        "color": "#5A3A22",
        "opacity": 0.85
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "value_class",
          "type": "ordinal",
          "sort": [
            "Under AUD 2 billion",
            "AUD 2–4 billion",
            "AUD 4 billion or more"
          ],
          "scale": {
            "domain": [
              "Under AUD 2 billion",
              "AUD 2–4 billion",
              "AUD 4 billion or more"
            ],
            "range": [
              100,
              700,
              1800
            ]
          },
          "legend": {
            "title": "Farm-gate value (AUD billion)",
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "circle",
            "symbolFillColor": "#5A3A22",
            "labelFontSize": 13,
            "titleFontSize": 13,
            "labelFont": "Inter",
            "titleFont": "Inter",
            "labelColor": "#5B4E49",
            "titleColor": "#5B4E49",
            "titleFontWeight": 600,
            "titleLimit": 400,
            "labelLimit": 200,
            "symbolOpacity": 0.85,
            "symbolStrokeWidth": 0
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "total_farm_gate_value_aud_m",
            "type": "quantitative",
            "title": "Five-category value (AUD million)",
            "format": ",.1f"
          },
          {
            "field": "value_class",
            "type": "nominal",
            "title": "Value class"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "Western\nAustralia",
            "longitude": 121.6,
            "latitude": -28.6
          },
          {
            "name": "Northern\nTerritory",
            "longitude": 133.5,
            "latitude": -19.6
          },
          {
            "name": "Queensland",
            "longitude": 144.0,
            "latitude": -26.4
          },
          {
            "name": "South\nAustralia",
            "longitude": 134.2,
            "latitude": -33.1
          },
          {
            "name": "New South\nWales",
            "longitude": 145.0,
            "latitude": -32.4
          },
          {
            "name": "Victoria",
            "longitude": 144.6,
            "latitude": -39.7
          },
          {
            "name": "Tasmania",
            "longitude": 146.6,
            "latitude": -44.6
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#2E2A27",
        "lineBreak": "\n",
        "align": "center",
        "baseline": "middle"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "name"
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    }
  }
}