{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Victoria leads Australia's cut-flower sector",
    "subtitle": "2024-25 · Farm-gate value, A$ million"
  },
  "description": "State-level choropleth of reported cut-flower farm-gate values. States without a matching value in the ABS Table 5 extract are shown in grey as no data, not zero.",
  "width": 680,
  "height": 455,
  "background": "#FFFFFF",
  "data": {
    "url": "maps/australia_states.topojson",
    "format": {
      "type": "topojson",
      "feature": "australia_states"
    }
  },
  "transform": [
    {
      "lookup": "properties.STE_NAME21",
      "from": {
        "data": {
          "url": "data/cut_flower_value_by_state.csv",
          "format": {
            "type": "csv"
          }
        },
        "key": "state",
        "fields": [
          "value_m",
          "year",
          "commodity",
          "measure"
        ]
      }
    },
    {
      "calculate": "isValid(datum.value_m) ? format(datum.value_m, '.1f') + ' million AUD' : 'No cut-flower value reported in Table 5'",
      "as": "value_label"
    }
  ],
  "projection": {
    "type": "equalEarth"
  },
  "mark": {
    "type": "geoshape",
    "stroke": "#FFFFFF",
    "strokeWidth": 1.2
  },
  "encoding": {
    "color": {
      "condition": {
        "test": "isValid(datum.value_m)",
        "field": "value_m",
        "type": "quantitative",
        "scale": {
          "domain": [
            0,
            115
          ],
          "range": [
            "#E4F1ED",
            "#176B63"
          ],
          "clamp": true
        },
        "legend": {
          "title": "Farm-gate value (A$ million)",
          "format": ".0f",
          "orient": "bottom",
          "gradientLength": 220
        }
      },
      "value": "#E9E5DF"
    },
    "tooltip": [
      {
        "field": "properties.STE_NAME21",
        "type": "nominal",
        "title": "State or territory"
      },
      {
        "field": "value_label",
        "type": "nominal",
        "title": "Cut-flower value"
      }
    ]
  },
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Inter",
      "fontSize": 20,
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#74686D"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 12
    },
    "geoshape": {
      "stroke": "#FFFFFF",
      "strokeWidth": 1.2
    }
  }
}
