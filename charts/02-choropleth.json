
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Where are cut flowers most important?",
    "subtitle": "2024-25 · Cut-flower farm-gate value as a share of reported horticulture value",
    "color" : "#1f382f"
  },
  "description": "The percentage is cut-flower farm-gate value from ABS Table 5 divided by the sum of the five horticulture summary categories reported for each state in ABS Table 1. The Northern Territory and Australian Capital Territory are shown as no data because a complete state denominator is not available in Table 1.",
  "width": 430,
  "height": 340,
  "background": "transparent",
  "projection": {
    "type": "equirectangular"
  },
  "layer": [
    {
      "data": {
        "url": "maps/australia_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "transform": [
        {
          "lookup": "properties.STE_NAME21",
          "from": {
            "data": {
              "url": "data/flower_share_by_state.csv",
              "format": {
                "type": "csv"
              }
            },
            "key": "state",
            "fields": [
              "cut_flower_value_m",
              "total_horticulture_value_m",
              "flower_share_pct"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#000000",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "condition": {
            "test": "isValid(datum.flower_share_pct)",
            "field": "flower_share_pct",
            "type": "quantitative",
            "scale": {
              "domain": [0, 5.5],
              "range": ["#FCE7EF", "#D6538A"],
              "clamp": true
            },
            "legend": {
              "title": "Cut-flower share (%)",
              "format": ".1f",
              "orient": "bottom",
              "gradientLength": 220
            }
          },
          "value": "#D8D3D5"
        },
        "tooltip": [
          {
            "field": "properties.STE_NAME21",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "cut_flower_value_m",
            "type": "quantitative",
            "title": "Cut-flower value (A$ million)",
            "format": ".1f"
          },
          {
            "field": "total_horticulture_value_m",
            "type": "quantitative",
            "title": "Total horticulture value (A$ million)",
            "format": ",.1f"
          },
          {
            "field": "flower_share_pct",
            "type": "quantitative",
            "title": "Cut-flower share (%)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "Name": "Western Australia",
            "lon": 122.3,
            "lat": -25.5
          },
          {
            "Name": "Northern\n Territory",
            "lon": 133.4,
            "lat": -19.5
          },
          {
            "Name": "South Australia",
            "lon": 135.2,
            "lat": -30.0
          },
          {
            "Name": "Queensland",
            "lon": 144.5,
            "lat": -22.5
          },
          {
            "Name": "New South\n Wales",
            "lon": 146.3,
            "lat": -32.3
          },
          {
            "Name": "Victoria",
            "lon": 144.0,
            "lat": -36.9
          },
          {
            "Name": "Tasmania",
            "lon": 146.6,
            "lat": -44.4
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Arial",
        "fontSize": 12,
        "fontWeight": "bold",
        "lineBreak": "\n",
        "align": "center"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "Name",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Newsreader",
      "fontSize": 20,
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleFontSize": 13,
      "subtitleColor": "#74686D"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 12,
      "titleFontSize": 12
    }
  }
}
