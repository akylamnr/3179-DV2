{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Queensland moved into the lead",
    "subtitle": "State and territory rankings for cut flowers, nurseries and turf · 2020-21 to 2024-25",
    "font": "Inter",
    "fontSize": 16,
    "anchor": "start",
    "subtitleFont": "Inter",
    "subtitleFontSize": 10,
    "subtitleColor": "#74686D"
  },
  "width": 350,
  "height": 275,
  "background": "transparent",
  "data": {
    "url": "data/horticulture_state_rankings.csv",
    "format": {
      "type": "csv"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.4,
        "point": {
          "filled": true,
          "size": 55
        }
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": [
            "2020-21",
            "2021-22",
            "2022-23",
            "2023-24",
            "2024-25"
          ],
          "title": "Financial year",
          "axis": {
            "labelAngle": 0,
            "labelFont": "Inter",
            "labelFontSize": 9,
            "labelPadding": 4,
            "title": "Financial year",
            "titleFont": "Inter",
            "titleFontSize": 10,
            "titlePadding": 7,
            "grid": false,
            "domain": true,
            "domainColor": "#8E8078",
            "domainWidth": 1.5,
            "ticks": true,
            "tickSize": 4,
            "tickColor": "#8E8078",
            "labelColor": "#5B4E49",
            "titleColor": "#5B4E49",
            "labelOverlap": false
          }
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "title": "Rank (1 = highest)",
          "scale": {
            "domain": [
              1,
              7
            ],
            "reverse": true,
            "nice": false,
            "zero": false
          },
          "axis": {
            "values": [
              1,
              2,
              3,
              4,
              5,
              6,
              7
            ],
            "format": ".0f",
            "labelFont": "Inter",
            "labelFontSize": 10,
            "labelPadding": 4,
            "title": "Rank (1 = highest)",
            "titleFont": "Inter",
            "titleFontSize": 10,
            "titlePadding": 7,
            "grid": true,
            "gridColor": "#E8DFDB",
            "gridOpacity": 1,
            "domain": true,
            "domainColor": "#8E8078",
            "domainWidth": 1.5,
            "ticks": true,
            "tickSize": 4,
            "tickColor": "#8E8078",
            "labelColor": "#5B4E49",
            "titleColor": "#5B4E49"
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "Queensland",
              "New South Wales",
              "Victoria",
              "Western Australia",
              "South Australia",
              "Tasmania",
              "Northern Territory"
            ],
            "range": [
              "#315F49",
              "#329481",
              "#D6538A",
              "#B695C9",
              "#D6A53A",
              "#A79D95",
              "#78736F"
            ]
          },
          "legend": null
        },
        "detail": {
          "field": "state"
        },
        "order": {
          "field": "period",
          "sort": [
            "2020-21",
            "2021-22",
            "2022-23",
            "2023-24",
            "2024-25"
          ]
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "period",
            "type": "ordinal",
            "title": "Financial year"
          },
          {
            "field": "rank",
            "type": "quantitative",
            "title": "Rank",
            "format": ".0f"
          },
          {
            "field": "value_m",
            "type": "quantitative",
            "title": "Farm-gate value (A$ million)",
            "format": ",.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.period === '2024-25'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "font": "Inter",
        "fontSize": 9,
        "fontWeight": 600,
        "clip": false
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": [
            "2020-21",
            "2021-22",
            "2022-23",
            "2023-24",
            "2024-25"
          ]
        },
        "y": {
          "field": "rank",
          "type": "quantitative",
          "scale": {
            "domain": [
              1,
              7
            ],
            "reverse": true,
            "nice": false,
            "zero": false
          }
        },
        "text": {
          "field": "latest_label",
          "type": "nominal"
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {
            "domain": [
              "Queensland",
              "New South Wales",
              "Victoria",
              "Western Australia",
              "South Australia",
              "Tasmania",
              "Northern Territory"
            ],
            "range": [
              "#315F49",
              "#329481",
              "#D6538A",
              "#B695C9",
              "#D6A53A",
              "#A79D95",
              "#78736F"
            ]
          },
          "legend": null
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Inter",
      "fontSize": 16,
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleFontSize": 10,
      "subtitleColor": "#74686D"
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 9,
      "titleFontSize": 10,
      "labelColor": "#5B4E49",
      "titleColor": "#5B4E49"
    }
  }
}