{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Indexed trend in Australian cut-flower production value, import value, export value and wholesale supply value. Each series is indexed to 100 in 2020–21. Nominal A$ values, not adjusted for inflation. Source: Hort Innovation, Australian Horticulture Statistics Handbook 2024/25, pp. 408–409.",
  "width": 400,
  "height": 330,
  "background": "transparent",
  "title": {
    "text": "Cut-flower values grew at different rates",
    "subtitle": "Indexed to 100 in 2020–21 · A$ values are nominal, not inflation-adjusted",
    "font": "Newsreader",
    "fontSize": 22,
    "fontWeight": "normal",
    "anchor": "start",
    "offset": 12,
    "subtitleFont": "Inter",
    "subtitleFontSize": 12,
    "subtitleColor": "#74686D"
  },
  "data": {
    "url": "data/cut_flower_value_trends.csv",
    "format": {
      "type": "csv"
    }
  },
  "layer": [
    {
      "data": {
        "values": [
          {
            "baseline": 100
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#928A8D",
        "strokeDash": [
          5,
          4
        ],
        "strokeWidth": 1.2
      },
      "encoding": {
        "y": {
          "field": "baseline",
          "type": "quantitative",
          "scale": {
            "domain": [
              90,
              126
            ]
          },
          "axis": {
            "title": "Index (2020–21 = 100)",
            "titleFont": "Inter",
            "labelFont": "Inter",
            "grid": true,
            "gridColor": "#EEE8E9",
            "tickCount": 5
          }
        },
        "tooltip": null
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.8,
        "point": {
          "filled": true,
          "size": 60
        }
      },
      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "ordinal",
          "sort": [
            "2020-21",
            "2021–22",
            "2022–23",
            "2023–24",
            "2024–25"
          ],
          "title": "Financial year",
          "axis": {
            "labelAngle": 0,
            "labelFont": "Inter",
            "labelFontSize": 11,
            "ticks": false,
            "domain": false
          },
          "scale": {
            "padding": 0.65
          }
        },
        "y": {
          "field": "index_2020_21",
          "type": "quantitative",
          "scale": {
            "domain": [
              90,
              126
            ]
          },
          "axis": {
            "title": "Index (2020–21 = 100)",
            "titleFont": "Inter",
            "labelFont": "Inter",
            "gridColor": "#EEE8E9",
            "tickCount": 5
          }
        },
        "color": {
          "field": "metric",
          "type": "nominal",
          "title": "Measure",
          "scale": {
            "domain": [
              "Production value",
              "Import value",
              "Export value",
              "Wholesale supply value"
            ],
            "range": [
              "#28483D",
              "#D6538A",
              "#D6A53A",
              "#2F65A7"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "titleFont": "Inter",
            "labelFont": "Inter",
            "labelFontSize": 11
          }
        },
        "detail": {
          "field": "metric"
        },
        "order": {
          "field": "year",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "metric",
            "type": "nominal",
            "title": "Measure"
          },
          {
            "field": "financial_year",
            "type": "nominal",
            "title": "Financial year"
          },
          {
            "field": "value_aud_m",
            "type": "quantitative",
            "title": "Value (A$ million)",
            "format": ",.1f"
          },
          {
            "field": "index_2020_21",
            "type": "quantitative",
            "title": "Index",
            "format": ".1f"
          },
          {
            "field": "growth_since_2020_21_pct",
            "type": "quantitative",
            "title": "Change since 2020–21 (%)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2025"
        }
      ],
      "mark": {
        "type": "rule",
        "stroke": "#74686D",
        "strokeWidth": 0.8,
        "strokeDash": [
          2,
          2
        ]
      },
      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "ordinal",
          "sort": [
            "2020–21",
            "2021–22",
            "2022–23",
            "2023–24",
            "2024–25"
          ],
          "scale": {
            "padding": 0.65
          }
        },
        "y": {
          "field": "index_2020_21",
          "type": "quantitative",
          "scale": {
            "domain": [
              90,
              126
            ]
          }
        },
        "y2": {
          "field": "end_label_y"
        },
        "detail": {
          "field": "metric"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year == 2025"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "financial_year",
          "type": "ordinal",
          "sort": [
            "2020–21",
            "2021–22",
            "2022–23",
            "2023–24",
            "2024–25"
          ],
          "scale": {
            "padding": 0.65
          }
        },
        "y": {
          "field": "end_label_y",
          "type": "quantitative",
          "scale": {
            "domain": [
              90,
              126
            ]
          }
        },
        "text": {
          "field": "end_label",
          "type": "nominal"
        },
        "color": {
          "field": "metric",
          "type": "nominal",
          "scale": {
            "domain": [
              "Production value",
              "Import value",
              "Export value",
              "Wholesale supply value"
            ],
            "range": [
              "#28483D",
              "#D6538A",
              "#D6A53A",
              "#2F65A7"
            ]
          },
          "legend": null
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#40363A",
      "titleColor": "#40363A",
      "domainColor": "#CFC5C9",
      "tickColor": "#CFC5C9"
    },
    "legend": {
      "labelColor": "#40363A",
      "titleColor": "#40363A"
    }
  },
  "padding": {
    "left": 5,
    "right": 150,
    "top": 8,
    "bottom": 8
  }
}
