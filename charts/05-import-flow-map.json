{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Inbound flower-trade flow map drawn as curved arcs. Each arc connects a top supplier country to Australia (HS 0603, 2024). Arc width shows import value.",
  "width": 820,
  "height": 450,
  "title": {
    "text": "Most imported flowers arrive from six countries",
    "subtitle": "Australia's cut-flower imports, 2024 · Line width shows value; the six leading suppliers account for about 91% of reported value."
  },
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0,
      0
    ]
  },
  "resolve": {
    "scale": {
      "size": "independent"
    }
  },
  "layer": [
    {
      "data": {
        "url": "maps/world_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "world_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F1EEE9",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.55
      }
    },
    {
      "data": {
        "url": "data/flower_import_flows.csv",
        "format": {
          "type": "csv",
          "parse": {
            "sequence": "number",
            "longitude": "number",
            "latitude": "number",
            "import_value_usd_m": "number",
            "quantity_kg": "number",
            "share_of_reported_total_pct": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.sequence == 0"
        },
        {
          "calculate": "datum.longitude < -30 ? datum.longitude + 360 : datum.longitude",
          "as": "lon0"
        },
        {
          "calculate": "149.13",
          "as": "lon2"
        },
        {
          "calculate": "-35.28",
          "as": "lat2"
        },
        {
          "calculate": "0.5 * (datum.lon0 + datum.lon2)",
          "as": "ctrl_lon"
        },
        {
          "calculate": "0.5 * (datum.latitude + datum.lat2) + 0.22 * abs(datum.lon2 - datum.lon0)",
          "as": "ctrl_lat"
        },
        {
          "calculate": "sequence(0, 41)",
          "as": "step"
        },
        {
          "flatten": [
            "step"
          ]
        },
        {
          "calculate": "datum.step / 40",
          "as": "t"
        },
        {
          "calculate": "pow(1 - datum.t, 2) * datum.lon0 + 2 * (1 - datum.t) * datum.t * datum.ctrl_lon + pow(datum.t, 2) * datum.lon2",
          "as": "arc_lon"
        },
        {
          "calculate": "pow(1 - datum.t, 2) * datum.latitude + 2 * (1 - datum.t) * datum.t * datum.ctrl_lat + pow(datum.t, 2) * datum.lat2",
          "as": "arc_lat"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#D98B35",
        "opacity": 0.65,
        "strokeCap": "round"
      },
      "encoding": {
        "longitude": {
          "field": "arc_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "arc_lat",
          "type": "quantitative"
        },
        "detail": {
          "field": "route",
          "type": "nominal"
        },
        "order": {
          "field": "step",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Supplier"
          },
          {
            "field": "import_value_usd_m",
            "type": "quantitative",
            "title": "Import value (US$ million)",
            "format": ".2f"
          },
          {
            "field": "quantity_kg",
            "type": "quantitative",
            "title": "Quantity (kg)",
            "format": ","
          },
          {
            "field": "share_of_reported_total_pct",
            "type": "quantitative",
            "title": "Share of total (%)",
            "format": ".1f"
          }
        ],
        "strokeWidth": {
          "field": "import_value_usd_m",
          "type": "quantitative",
          "title": "Import value (US$ million)",
          "scale": {
            "domain": [
              0,
              20
            ],
            "range": [
              1.2,
              6.2
            ],
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "values": [
              5,
              10,
              15,
              20
            ],
            "format": ".0f",
            "symbolType": "stroke",
            "symbolStrokeColor": "#D98B35",
            "symbolStrokeWidth": 1.5,
            "title": "Import value (US$ million)",
            "labelFont": "Inter",
            "titleFont": "Inter",
            "labelFontSize": 11,
            "titleFontSize": 11,
            "padding": 6
          }
        }
      }
    },
    {
      "data": {
        "url": "data/flower_import_flows.csv",
        "format": {
          "type": "csv",
          "parse": {
            "sequence": "number",
            "longitude": "number",
            "latitude": "number",
            "import_value_usd_m": "number",
            "quantity_kg": "number",
            "share_of_reported_total_pct": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.sequence == 0"
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.2,
        "opacity": 0.95
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "import_value_usd_m",
          "type": "quantitative",
          "scale": {
            "type": "sqrt",
            "domain": [
              0,
              20
            ],
            "range": [
              60,
              1100
            ],
            "clamp": true
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Supplier"
          },
          {
            "field": "import_value_usd_m",
            "type": "quantitative",
            "title": "Import value (US$ million)",
            "format": ".2f"
          }
        ],
        "color": {
          "field": "import_value_usd_m",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              20
            ],
            "range": [
              "#F7DDBB",
              "#B85C16"
            ],
            "clamp": true
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "url": "data/flower_import_flows.csv",
        "format": {
          "type": "csv",
          "parse": {
            "sequence": "number",
            "longitude": "number",
            "latitude": "number",
            "import_value_usd_m": "number",
            "quantity_kg": "number",
            "share_of_reported_total_pct": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.sequence == 0"
        },
        {
          "calculate": "datum.country === 'Colombia' ? datum.latitude + 6 : datum.country === 'Ecuador' ? datum.latitude - 4 : datum.latitude",
          "as": "label_latitude"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#1B2B26",
        "font": "Inter",
        "stroke": "#FFFFFF",
        "strokeWidth": 2,
        "strokeJoin": "round"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "label_latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "country",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "Australia",
            "longitude": 149.13,
            "latitude": -35.28
          }
        ]
      },
      "mark": {
        "type": "point",
        "shape": "diamond",
        "filled": true,
        "size": 200,
        "color": "#176B63",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": {
          "field": "name",
          "type": "nominal",
          "title": "Destination"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "Australia",
            "longitude": 149.13,
            "latitude": -35.28
          }
        ]
      },
      "mark": {
        "type": "text",
        "dy": 17,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#176B63"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "background": "#FFFFFF",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Inter",
      "fontSize": 21,
      "fontWeight": "bold",
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleFontSize": 12,
      "subtitleColor": "#74686D",
      "offset": 12
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "padding": 5
    }
  }
}
