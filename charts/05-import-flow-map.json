{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Inbound flower-trade flow map drawn as curved arcs. Each arc connects a top supplier country to Australia (HS 0603, 2024). Arc width shows import value.",
  "width": 820,
  "height": 450,
  "title": {
    "text": "Most imported flowers arrive from six countries",
    "subtitle": "Australia's cut-flower imports, 2024. Arc width shows value. The top six suppliers made up about 91% of reported value."
  },
  "projection": {
    "type": "equalEarth",
    "rotate": [
      -150,
      0,
      0
    ]
  },
  "resolve": {
    "scale": {
      "size": "independent"
    }
  },
  "layer": [
    {
      "data": {
        "url": "maps/world_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "world_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#F1EEE9",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.55
      }
    },
    {
      "data": {
        "url": "data/flower_import_flows.csv",
        "format": {
          "type": "csv",
          "parse": {
            "sequence": "number",
            "longitude": "number",
            "latitude": "number",
            "import_value_usd_m": "number",
            "quantity_kg": "number",
            "share_of_reported_total_pct": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.sequence == 0"
        },
        {
          "calculate": "datum.longitude < -30 ? datum.longitude + 360 : datum.longitude",
          "as": "lon0"
        },
        {
          "calculate": "149.13",
          "as": "lon2"
        },
        {
          "calculate": "-35.28",
          "as": "lat2"
        },
        {
          "calculate": "0.5 * (datum.lon0 + datum.lon2)",
          "as": "ctrl_lon"
        },
        {
          "calculate": "0.5 * (datum.latitude + datum.lat2) + 0.22 * abs(datum.lon2 - datum.lon0)",
          "as": "ctrl_lat"
        },
        {
          "calculate": "sequence(0, 41)",
          "as": "step"
        },
        {
          "flatten": [
            "step"
          ]
        },
        {
          "calculate": "datum.step / 40",
          "as": "t"
        },
        {
          "calculate": "pow(1 - datum.t, 2) * datum.lon0 + 2 * (1 - datum.t) * datum.t * datum.ctrl_lon + pow(datum.t, 2) * datum.lon2",
          "as": "arc_lon"
        },
        {
          "calculate": "pow(1 - datum.t, 2) * datum.latitude + 2 * (1 - datum.t) * datum.t * datum.ctrl_lat + pow(datum.t, 2) * datum.lat2",
          "as": "arc_lat"
        }
      ],
      "mark": {
        "type": "line",
        "color": "#D98B35",
        "opacity": 0.65,
        "strokeCap": "round"
      },
      "encoding": {
        "longitude": {
          "field": "arc_lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "arc_lat",
          "type": "quantitative"
        },
        "detail": {
          "field": "route",
          "type": "nominal"
        },
        "order": {
          "field": "step",
          "type": "quantitative"
        },
        "size": {
          "field": "import_value_usd_m",
          "type": "quantitative",
          "title": "Import value (US$ million)",
          "scale": {
            "domain": [
              0,
              20
            ],
            "range": [
              24,
              1000
            ],
            "clamp": true
          },
          "legend": {
            "orient": "bottom",
            "symbolFillColor": "#D98B35",
            "title": "Import value (US$ million)",
            "format": ".1f"
          },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Supplier"
          },
          {
            "field": "import_value_usd_m",
            "type": "quantitative",
            "title": "Import value (US$ million)",
            "format": ".2f"
          },
          {
            "field": "quantity_kg",
            "type": "quantitative",
            "title": "Quantity (kg)",
            "format": ","
          },
          {
            "field": "share_of_reported_total_pct",
            "type": "quantitative",
            "title": "Share of total (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/flower_import_flows.csv",
        "format": {
          "type": "csv",
          "parse": {
            "sequence": "number",
            "longitude": "number",
            "latitude": "number",
            "import_value_usd_m": "number",
            "quantity_kg": "number",
            "share_of_reported_total_pct": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.sequence == 0"
        }
      ],
      "mark": {
        "type": "circle",
        "color": "#D98B35",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.2,
        "opacity": 0.95
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "import_value_usd_m",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              20
            ],
            "range": [
              40,
              400
            ],
            "clamp": true
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Supplier"
          },
          {
            "field": "import_value_usd_m",
            "type": "quantitative",
            "title": "Import value (US$ million)",
            "format": ".2f"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/flower_import_flows.csv",
        "format": {
          "type": "csv",
          "parse": {
            "sequence": "number",
            "longitude": "number",
            "latitude": "number",
            "import_value_usd_m": "number",
            "quantity_kg": "number",
            "share_of_reported_total_pct": "number"
          }
        }
      },
      "transform": [
        {
          "filter": "datum.sequence == 0"
        }
      ],
      "mark": {
        "type": "text",
        "dy": -14,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#1B2B26"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "country",
          "type": "nominal"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "Australia",
            "longitude": 149.13,
            "latitude": -35.28
          }
        ]
      },
      "mark": {
        "type": "point",
        "shape": "diamond",
        "filled": true,
        "size": 200,
        "color": "#176B63",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.5
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "tooltip": {
          "field": "name",
          "type": "nominal",
          "title": "Destination"
        }
      }
    },
    {
      "data": {
        "values": [
          {
            "name": "Australia",
            "longitude": 149.13,
            "latitude": -35.28
          }
        ]
      },
      "mark": {
        "type": "text",
        "dy": 17,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#176B63"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "name",
          "type": "nominal"
        }
      }
    }
  ]
}