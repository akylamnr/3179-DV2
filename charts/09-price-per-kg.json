{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Lollipop chart of the average import price per kilogram of cut flowers (HS 0603) from each top supplier, with the average of all six marked.",
  "width": 500,
  "height": 260,
  "background": "transparent",
  "title": {
    "text": "What Each Supplier's Flowers Cost per Kilogram",
    "subtitle": "Import value divided by weight · 2024.",
    "font": "Inter",
    "fontWeight": 700,
    "fontSize": 19,
    "color": "#1f382f",
    "anchor": "start",
    "offset": 10,
    "subtitleFont": "Inter",
    "subtitleFontSize": 15,
    "subtitleColor": "#74686D",
    "subtitleFontWeight": "normal"
  },
  "data": {
    "url": "data/flower_import_flows.csv",
    "format": {
      "type": "csv",
      "parse": {
        "sequence": "number",
        "import_value_usd_m": "number",
        "quantity_kg": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.sequence == 0"
    },
    {
      "calculate": "datum.import_value_usd_m * 1000000 / datum.quantity_kg",
      "as": "usd_per_kg"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "import_value_usd_m",
          "as": "sum_value"
        },
        {
          "op": "sum",
          "field": "quantity_kg",
          "as": "sum_kg"
        }
      ]
    },
    {
      "calculate": "datum.sum_value * 1000000 / datum.sum_kg",
      "as": "avg_price"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#D6538A",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": "-x",
          "title": null,
          "axis": {
            "domain": false,
            "ticks": false,
            "labelFontSize": 13,
            "labelFont": "Inter",
            "titleFont": "Inter",
            "titleFontSize": 13,
            "labelColor": "#000000",
            "titleColor": "#000000",
            "titleFontWeight": 600
          }
        },
        "x": {
          "field": "usd_per_kg",
          "type": "quantitative",
          "title": "Import price (USD per kg)",
          "axis": {
            "format": "$.0f",
            "grid": false,
            "labelFont": "Inter",
            "titleFont": "Inter",
            "labelFontSize": 13,
            "titleFontSize": 13,
            "labelColor": "#000000",
            "titleColor": "#000000",
            "titleFontWeight": 600
          }
        },
        "x2": {
          "datum": 0
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "color": "#D6538A",
        "size": 190,
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "usd_per_kg",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "country",
            "type": "nominal",
            "title": "Supplier"
          },
          {
            "field": "usd_per_kg",
            "type": "quantitative",
            "title": "USD per kg",
            "format": ".2f"
          },
          {
            "field": "import_value_usd_m",
            "type": "quantitative",
            "title": "Import value (USD million)",
            "format": ".2f"
          },
          {
            "field": "quantity_kg",
            "type": "quantitative",
            "title": "Quantity (kg)",
            "format": ","
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontSize": 12,
        "color": "#1B2B26"
      },
      "encoding": {
        "y": {
          "field": "country",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "usd_per_kg",
          "type": "quantitative"
        },
        "text": {
          "field": "usd_per_kg",
          "type": "quantitative",
          "format": "$.2f"
        }
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#28483D",
        "strokeDash": [
          5,
          4
        ],
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "avg_price",
          "type": "quantitative",
          "aggregate": "mean"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 6,
        "dy": 2,
        "fontSize": 12,
        "fontWeight": 600,
        "color": "#28483D"
      },
      "encoding": {
        "x": {
          "field": "avg_price",
          "type": "quantitative",
          "aggregate": "mean"
        },
        "y": {
          "value": 0
        },
        "text": {
          "value": "Average Cost/kg"
        }
      }
    }
  ]
}