{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Farm-Gate Value of Australia's Horticulture (2020-21, 2024-25)",
    "offset": 10,
    "font": "Inter",
    "fontWeight": 700,
    "fontSize": 19,
    "anchor": "start",
    "color": "#1f382f"
  },
  "width": 430,
  "height": 340,
  "background": "transparent",
  "data": {
    "url": "data/horticulture_value_trends.csv",
    "format": {
      "type": "csv"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.8,
        "point": {
          "filled": true,
          "size": 72
        }
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": [
            "2020-21",
            "2024-25"
          ],
          "scale": {
            "padding": 0.16
          },
          "title": "Financial year",
          "axis": {
            "orient": "bottom",
            "labelAngle": 0,
            "labelFont": "Inter",
            "labelFontSize": 13,
            "labelPadding": 5,
            "title": "Financial year",
            "titleFont": "Inter",
            "titleFontSize": 13,
            "titlePadding": 7,
            "grid": false,
            "domain": true,
            "domainColor": "#8E8078",
            "domainWidth": 1.5,
            "ticks": true,
            "tickSize": 5,
            "tickColor": "#8E8078",
            "labelColor": "#000000",
        "titleColor": "#000000",
            "labelOverlap": false,
            "titleFontWeight": 600
          }
        },
        "y": {
          "field": "value_m",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              8200
            ],
            "nice": false,
            "zero": true
          },
          "title": "Farm-gate value (AUD million)",
          "axis": {
            "orient": "left",
            "values": [
              0,
              2000,
              4000,
              6000,
              8000
            ],
            "format": ",.0f",
            "labelFont": "Inter",
            "labelFontSize": 13,
            "labelPadding": 4,
            "title": "Farm-gate value (AUD million)",
            "titleFont": "Inter",
            "titleFontSize": 13,
            "titlePadding": 7,
            "grid": true,
            "gridColor": "#E8DFDB",
            "gridOpacity": 1,
            "domain": true,
            "domainColor": "#8E8078",
            "domainWidth": 1.5,
            "ticks": true,
            "tickSize": 4,
            "tickColor": "#8E8078",
            "labelColor": "#000000",
        "titleColor": "#000000",
            "titleFontWeight": 600
          }
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": [
              "Cut flowers, nurseries and turf",
              "Fruit (excluding wine grapes)",
              "Vegetables",
              "Nuts",
              "Wine grapes"
            ],
            "range": [
              "#D6538A",
              "#ee9f27",
              "#329481",
              "#B695C9",
              "#B7C75E"
            ]
          },
          "legend": null
        },
        "detail": {
          "field": "category"
        },
        "order": {
          "field": "period",
          "sort": [
            "2020-21",
            "2024-25"
          ]
        },
        "tooltip": [
          {
            "field": "category",
            "type": "nominal",
            "title": "Category"
          },
          {
            "field": "period",
            "type": "ordinal",
            "title": "Financial year"
          },
          {
            "field": "value_m",
            "type": "quantitative",
            "title": "Farm-gate value (AUD million)",
            "format": ",.1f"
          },
          {
            "field": "change_percent",
            "type": "quantitative",
            "title": "Change since 2020-21 (%)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.period === '2024-25' && datum.end_label != null && datum.end_label !== ''"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": 600,
        "clip": false
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": [
            "2020-21",
            "2024-25"
          ],
          "scale": {
            "padding": 0.16
          }
        },
        "y": {
          "field": "value_m",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              8200
            ],
            "nice": false,
            "zero": true
          }
        },
        "text": {
          "field": "end_label",
          "type": "nominal"
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": [
              "Cut flowers, nurseries and turf",
              "Fruit (excluding wine grapes)",
              "Vegetables",
              "Nuts",
              "Wine grapes"
            ],
            "range": [
              "#D6538A",
              "#EE9F27",
              "#329481",
              "#B695C9",
              "#B7C75E"
            ]
          },
          "legend": null
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    }
  }
}