{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Australia's 2024 imports from the six leading origin countries, stacked by fresh-cut flower category. Lilies are excluded because their import values are very small.",
  "title": {
    "text": "What types of flowers come from the top six origins?",
    "subtitle": "Selected partner countries · by flower type · 2024 · US$ million",
    "font": "Inter",
    "fontWeight": 700,
    "fontSize": 19,
    "anchor": "start",
    "subtitleFont": "Inter",
    "subtitleFontSize": 12,
    "subtitleColor": "#74686D",
    "offset": 10,
    "color": "#1f382f",
    "subtitleFontWeight": "normal"
  },
  "width": 650,
  "height": 280,
  "background": "transparent",
  "data": {
    "url": "data/cut_flower_imports_top_origins_stacked_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "import_value_usd_m": "number",
        "year": "number"
      }
    }
  },
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 4
  },
  "encoding": {
    "x": {
      "field": "country",
      "type": "nominal",
      "sort": [
        "Malaysia",
        "Kenya",
        "Ecuador",
        "Vietnam",
        "Colombia",
        "China"
      ],
      "title": "Country Origin",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 13,
        "grid": false,
        "labelFont": "Inter",
        "titleFont": "Inter",
        "titleFontSize": 13,
        "labelColor": "#5B4E49",
        "titleColor": "#5B4E49",
        "titleFontWeight": 600
      }
    },
    "y": {
      "field": "import_value_usd_m",
      "type": "quantitative",
      "stack": "zero",
      "title": "Import value (US$ million)",
      "scale": {
        "zero": true
      },
      "axis": {
        "format": "$.0f",
        "grid": true,
        "gridColor": "#E8DFDB",
        "labelFont": "Inter",
        "titleFont": "Inter",
        "labelFontSize": 13,
        "titleFontSize": 13,
        "labelColor": "#5B4E49",
        "titleColor": "#5B4E49",
        "titleFontWeight": 600
      }
    },
    "color": {
      "field": "variety",
      "type": "nominal",
      "title": "Flower type",
      "scale": {
        "domain": [
          "Roses",
          "Chrysanthemums",
          "Other cut flowers",
          "Orchids",
          "Carnations"
        ],
        "range": [
          "#B94F59",
          "#E6A23C",
          "#8F9290",
          "#A486C4",
          "#D978A5"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "title": "Flower type",
        "labelFontSize": 13,
        "labelFont": "Inter",
        "titleFont": "Inter",
        "titleFontSize": 13,
        "labelColor": "#5B4E49",
        "titleColor": "#5B4E49",
        "titleFontWeight": 600
      }
    },
    "order": {
      "field": "variety",
      "type": "nominal",
      "sort": [
        "Roses",
        "Chrysanthemums",
        "Other cut flowers",
        "Orchids",
        "Carnations"
      ]
    },
    "tooltip": [
      {
        "field": "country",
        "type": "nominal",
        "title": "Origin"
      },
      {
        "field": "variety",
        "type": "nominal",
        "title": "Flower type"
      },
      {
        "field": "import_value_usd_m",
        "type": "quantitative",
        "title": "Import value (US$ million)",
        "format": ".3f"
      }
    ],
    "opacity": {
      "condition": {
        "param": "flowerType",
        "value": 1
      },
      "value": 0.25
    }
  },
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    }
  },
  "params": [
    {
      "name": "flowerType",
      "select": {
        "type": "point",
        "fields": [
          "variety"
        ]
      },
      "bind": "legend"
    }
  ]
}