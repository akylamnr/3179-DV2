{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Australia's 2024 imports from the six leading origin countries, stacked by fresh-cut flower category. Lilies are excluded because their import values are very small.",
  "title": {
    "text": "What Types of Flowers Come From the Top Six Origins?",
    "subtitle": "Share of each origin's import value by flower type · 2024",
    "font": "Inter",
    "fontSize": 20,
    "fontWeight": 700,
    "color": "#1f382f",
    "anchor": "start",
    "offset": 12,
    "subtitleFont": "Inter",
    "subtitleFontSize": 14,
    "subtitleFontWeight": "normal",
    "subtitleColor": "#74686D",
    "subtitlePadding": 4
  },
  "width": 650,
  "height": 280,
  "background": "transparent",
  "data": {
    "url": "data/cut_flower_imports_top_origins_stacked_2024.csv",
    "format": {
      "type": "csv",
      "parse": {
        "import_value_usd_m": "number",
        "year": "number"
      }
    }
  },
  "mark": {
    "type": "bar"
  },
  "encoding": {
    "x": {
      "field": "country",
      "type": "nominal",
      "sort": [
        "Malaysia",
        "Kenya",
        "Ecuador",
        "Vietnam",
        "Colombia",
        "China"
      ],
      "title": "Country Origin",
      "axis": {
        "labelAngle": 0,
        "labelFontSize": 13,
        "grid": false,
        "labelFont": "Inter",
        "titleFont": "Inter",
        "titleFontSize": 13,
        "labelColor": "#000000",
        "titleColor": "#000000",
        "titleFontWeight": 600
      }
    },
    "y": {
      "field": "import_value_usd_m",
      "type": "quantitative",
      "stack": "normalize",
      "title": "Share of import value",
      "scale": {
        "domain": [
          0,
          1
        ]
      },
      "axis": {
        "format": ".0%",
        "grid": true,
        "gridColor": "#E8DFDB",
        "labelFont": "Inter",
        "titleFont": "Inter",
        "labelFontSize": 13,
        "titleFontSize": 13,
        "titleFontWeight": 600,
        "labelColor": "#000000",
        "titleColor": "#000000"
      }
    },
    "color": {
      "field": "variety",
      "type": "nominal",
      "title": "Flower type",
      "scale": {
        "domain": [
          "Roses",
          "Chrysanthemums",
          "Other cut flowers",
          "Orchids",
          "Carnations"
        ],
        "range": [
          "#B94F59",
          "#E6A23C",
          "#8F9290",
          "#A486C4",
          "#D978A5"
        ]
      },
      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "title": "Flower type",
        "labelFontSize": 13,
        "labelFont": "Inter",
        "titleFont": "Inter",
        "titleFontSize": 13,
        "labelColor": "#000000",
        "titleColor": "#000000",
        "titleFontWeight": 600
      }
    },
    "order": {
      "field": "variety",
      "type": "nominal",
      "sort": [
        "Roses",
        "Chrysanthemums",
        "Other cut flowers",
        "Orchids",
        "Carnations"
      ]
    },
    "tooltip": [
      {
        "field": "country",
        "type": "nominal",
        "title": "Origin"
      },
      {
        "field": "variety",
        "type": "nominal",
        "title": "Flower type"
      },
      {
        "field": "share",
        "type": "quantitative",
        "title": "Share of origin's imports",
        "format": ".1%"
      },
      {
        "field": "import_value_usd_m",
        "type": "quantitative",
        "title": "Import value (USD million)",
        "format": ".2f"
      },
      {
        "field": "country_total",
        "type": "quantitative",
        "title": "Origin total (USD million)",
        "format": ".2f"
      }
    ],
    "opacity": {
      "condition": {
        "param": "flowerType",
        "value": 1
      },
      "value": 0.25
    }
  },
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    }
  },
  "params": [
    {
      "name": "flowerType",
      "select": {
        "type": "point",
        "fields": [
          "variety"
        ]
      },
      "bind": "legend"
    }
  ],
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "import_value_usd_m",
          "as": "country_total"
        }
      ],
      "groupby": [
        "country"
      ]
    },
    {
      "calculate": "datum.country_total > 0 ? datum.import_value_usd_m / datum.country_total : 0",
      "as": "share"
    }
  ]
}