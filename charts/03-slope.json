{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Farm-gate value changed unevenly",
    "subtitle": "2020-21 to 2024-25 · A$ million, not adjusted for inflation",
    "font": "Inter",
    "fontSize": 16,
    "anchor": "start",
    "subtitleFont": "Inter",
    "subtitleFontSize": 11,
    "subtitleColor": "#74686D"
  },
  "width": 350,
  "height": 275,
  "background": "#FFFFFF",
  "data": {
    "url": "data/horticulture_value_trends.csv",
    "format": {
      "type": "csv"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.8,
        "point": {
          "filled": true,
          "size": 72
        }
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": [
            "2020-21",
            "2024-25"
          ],
          "scale": {
            "padding": 0.16
          },
          "title": "Financial year",
          "axis": {
            "orient": "bottom",
            "labelAngle": 0,
            "labelFont": "Inter",
            "labelFontSize": 10,
            "labelPadding": 5,
            "title": "Financial year",
            "titleFont": "Inter",
            "titleFontSize": 10,
            "titlePadding": 7,
            "grid": false,
            "domain": true,
            "domainColor": "#8E8078",
            "domainWidth": 1.5,
            "ticks": true,
            "tickSize": 5,
            "tickColor": "#8E8078",
            "labelColor": "#5B4E49",
            "titleColor": "#5B4E49",
            "labelOverlap": false
          }
        },
        "y": {
          "field": "value_m",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              8200
            ],
            "nice": false,
            "zero": true
          },
          "title": "Farm-gate value (A$ million)",
          "axis": {
            "orient": "left",
            "values": [
              0,
              2000,
              4000,
              6000,
              8000
            ],
            "format": ",.0f",
            "labelFont": "Inter",
            "labelFontSize": 10,
            "labelPadding": 4,
            "title": "Farm-gate value (A$ million)",
            "titleFont": "Inter",
            "titleFontSize": 10,
            "titlePadding": 7,
            "grid": true,
            "gridColor": "#E8DFDB",
            "gridOpacity": 1,
            "domain": true,
            "domainColor": "#8E8078",
            "domainWidth": 1.5,
            "ticks": true,
            "tickSize": 4,
            "tickColor": "#8E8078",
            "labelColor": "#5B4E49",
            "titleColor": "#5B4E49"
          }
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": [
              "Cut flowers, nurseries and turf",
              "Fruit (excluding wine grapes)",
              "Vegetables",
              "Nuts",
              "Wine grapes"
            ],
            "range": [
              "#D6538A",
              "#315F49",
              "#329481",
              "#B695C9",
              "#D6A53A"
            ]
          },
          "legend": null
        },
        "detail": {
          "field": "category"
        },
        "order": {
          "field": "period",
          "sort": [
            "2020-21",
            "2024-25"
          ]
        },
        "tooltip": [
          {
            "field": "category",
            "type": "nominal",
            "title": "Category"
          },
          {
            "field": "period",
            "type": "ordinal",
            "title": "Financial year"
          },
          {
            "field": "value_m",
            "type": "quantitative",
            "title": "Farm-gate value (A$ million)",
            "format": ",.1f"
          },
          {
            "field": "change_percent",
            "type": "quantitative",
            "title": "Change since 2020-21 (%)",
            "format": "+.1f"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.period === '2024-25' && datum.end_label != null && datum.end_label !== ''"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "font": "Inter",
        "fontSize": 9,
        "fontWeight": 600,
        "clip": false
      },
      "encoding": {
        "x": {
          "field": "period",
          "type": "ordinal",
          "sort": [
            "2020-21",
            "2024-25"
          ],
          "scale": {
            "padding": 0.16
          }
        },
        "y": {
          "field": "value_m",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              8200
            ],
            "nice": false,
            "zero": true
          }
        },
        "text": {
          "field": "end_label",
          "type": "nominal"
        },
        "color": {
          "field": "category",
          "type": "nominal",
          "scale": {
            "domain": [
              "Cut flowers, nurseries and turf",
              "Fruit (excluding wine grapes)",
              "Vegetables",
              "Nuts",
              "Wine grapes"
            ],
            "range": [
              "#D6538A",
              "#315F49",
              "#329481",
              "#B695C9",
              "#D6A53A"
            ]
          },
          "legend": null
        }
      }
    }
  ],
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Inter",
      "fontSize": 16,
      "anchor": "start",
      "subtitleFont": "Inter",
      "subtitleFontSize": 11,
      "subtitleColor": "#74686D"
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 10,
      "titleFontSize": 10,
      "labelColor": "#5B4E49",
      "titleColor": "#5B4E49"
    }
  }
}